# Cerebras AI API Key
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Optional: Choose model (default: llama-3.3-70b)
CEREBRAS_MODEL=llama-3.3-70b

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://hiresense_user:hiresense_password@localhost:5433/hiresense_db
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hiresense_db
DB_USER=hiresense_user
DB_PASSWORD=hiresense_password
